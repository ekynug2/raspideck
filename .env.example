# RaspiDeck Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# === Authentication ===
ADMIN_PASSWORD=your-admin-password-here
SECRET_KEY=your-random-secret-key-here

# === Storage Paths ===
MEDIA_DIR=/data/media
DB_PATH=/data/deck.db

# === Upload Limit (in MB) ===
MAX_CONTENT_LENGTH=100

# === Security ===
# Set to true if running behind HTTPS (e.g. via Cloudflare Tunnel or Nginx SSL)
HTTPS_ONLY=false

# === CORS Origins ===
# Comma-separated list or JSON array of allowed origins / regex patterns for /api/*
CORS_ORIGINS=https://your-domain.com,http://localhost:*,http://127.0.0.1:*,http://192\.168\..*

# === Cloudflare Tunnel ===
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
